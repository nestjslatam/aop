{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "../../dist/libs/logger",
    "rootDir": "src",
    "baseUrl": "../..",
    "paths": {
      "@nestjslatam/aop": [
        "dist/libs/aop"
      ],
      "@nestjslatam/aop.aspects": [
        "dist/libs/aop.aspects"
      ],
      "@nestjslatam/aop.aspects.logger": [
        "dist/libs/aop.aspects.logger"
      ],
      "@nestjslatam/aop.nestjs": [
        "dist/libs/aop.nestjs"
      ],
      "@nestjslatam/logreflector-lib": [
        "dist/libs/logger"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*spec.ts"
  ]
}
